# Salin file ini menjadi .env lalu sesuaikan dengan PostgreSQL lokal Anda.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arsipindex?schema=public"

# Port server NestJS
PORT=3001

# Origin frontend yang diizinkan CORS (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN="http://localhost:5173"
